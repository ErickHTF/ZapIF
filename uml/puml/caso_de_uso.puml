@startuml caso_de_uso
title ZapIF — Use Case Diagram

skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor #EEF2FF
    BorderColor     #4F46E5
    FontSize        13
}
skinparam actor {
    BackgroundColor #F0FDF4
    BorderColor     #16A34A
    FontSize        13
}
skinparam rectangle {
    BackgroundColor #FAFAFA
    BorderColor     #94A3B8
}
skinparam ArrowColor #475569
skinparam Shadowing false

' ── Actors ────────────────────────────────────────────────────────
actor "Unauthenticated\nUser" as Anonimo
actor "Authenticated\nUser"     as Autenticado

' ── System ───────────────────────────────────────────────────────
rectangle "ZapIF" {

    ' Pre-login
    usecase "Sign up" as UC01
    usecase "Log in"          as UC02

    ' Post-login — navigation
    usecase "View available rooms"         as UC03
    usecase "Join room"                    as UC04
    usecase "Switch rooms"                 as UC08

    ' Post-login — messages
    usecase "Send message"                   as UC05
    usecase "Receive message in real time"   as UC06
    usecase "View room history"              as UC07

    ' Connection
    usecase "Disconnect"               as UC09
    usecase "Reconnect automatically"  as UC14

    ' Internal server behavior (include/extend)
    usecase "Validate credentials\n(PBKDF2)"         as UC10
    usecase "Persist message\n(SQLite)"           as UC11
    usecase "Broadcast message"       as UC12
    usecase "Detect inactivity\n(PING / PONG)"    as UC13
}

' ── Unauthenticated User associations ─────────────────────────────
Anonimo --> UC01
Anonimo --> UC02

' ── Authenticated User associations ─────────────────────────────
Autenticado --> UC03
Autenticado --> UC04
Autenticado --> UC05
Autenticado --> UC06
Autenticado --> UC07
Autenticado --> UC08
Autenticado --> UC09

' ── Include (mandatory behavior) ─────────────────────────────────
UC02 ..> UC10 : <<include>>
UC05 ..> UC11 : <<include>>
UC05 ..> UC12 : <<include>>
UC04 ..> UC07 : <<include>>

' ── Extend (conditional behavior) ─────────────────────────────────
UC09 ..> UC14 : <<extend>>\nnetwork drop
UC13 ..> UC09 : <<extend>>\ntimeout without PONG

@enduml
