@startuml diagrama_pacotes
title ZapIF — Package and Architecture Diagram

skinparam Shadowing false
skinparam linetype ortho
skinparam ArrowColor #475569
skinparam ArrowThickness 1.2

skinparam package {
    BackgroundColor     #FAFAFA
    BorderColor         #94A3B8
    FontSize            13
    FontStyle           bold
}
skinparam component {
    BackgroundColor     #F8FAFC
    BorderColor         #475569
    FontSize            12
}
skinparam database {
    BackgroundColor     #FFF7ED
    BorderColor         #EA580C
    FontSize            12
}
skinparam node {
    BackgroundColor     #F0F9FF
    BorderColor         #0284C7
    FontSize            13
}

' ═══════════════════════════════════════════════════════
' CLIENT SIDE
' ═══════════════════════════════════════════════════════
node "User Machine\n(JavaFX Desktop)" as MaquinaCliente {

    package "client" {

        package "client.ui" {
            [ControladorLogin]
            [ControladorChat]
        }

        package "client.network" {
            [Conexao]
            [OuvinteMensagem]
            [OuvinteStatusConexao]
        }

        package "client.model" {
            [Mensagem]
            [Usuario]
        }

        [Main]
    }
}

' ═══════════════════════════════════════════════════════
' SERVER SIDE
' ═══════════════════════════════════════════════════════
node "Server\n(Java SE — single process)" as MaquinaServidor {

    package "server" {
        [Servidor]
        [ManipuladorCliente]
        [Sala]
        [RegistroSessao]
        [BancoDados]
    }

    database "SQLite\nchat.db" as DB {
        [usuarios]
        [salas]
        [mensagens]
    }
}

' ═══════════════════════════════════════════════════════
' INTERNAL DEPENDENCIES — CLIENT
' ═══════════════════════════════════════════════════════
[Main]             --> [Conexao]              : creates
[ControladorLogin] --> [Conexao]              : uses
[ControladorChat]  --> [Conexao]              : uses
[ControladorLogin] ..> [ControladorChat]      : opens
[ControladorChat]  ..> [Mensagem]             : instantiates
[Conexao]          ..> [OuvinteMensagem]      : notifies
[Conexao]          ..> [OuvinteStatusConexao] : notifies

' ═══════════════════════════════════════════════════════
' INTERNAL DEPENDENCIES — SERVER
' ═══════════════════════════════════════════════════════
[Servidor]           --> [ManipuladorCliente] : submits to pool
[ManipuladorCliente] --> [Sala]              : joins / leaves
[ManipuladorCliente] --> [BancoDados]        : persists / queries
[ManipuladorCliente] --> [RegistroSessao]    : registers / releases
[Sala]               --> [ManipuladorCliente] : broadcast
[BancoDados]         --> DB                  : JDBC

' ═══════════════════════════════════════════════════════
' CLIENT-SERVER COMMUNICATION
' ═══════════════════════════════════════════════════════
[Conexao] <--> [ManipuladorCliente] : TCP Socket · port 5001\n"|"-separated text protocol

@enduml
